# Normalise line endings: this is a Windows-first codebase, but keep the repo
# portable for anyone cloning on macOS or Linux.
* text=auto eol=lf

# Windows-only binary artifacts stay untouched.
*.ico binary
*.png binary
*.exe binary
*.dll binary

# Keep the lockfile and markdown out of diff noise.
package-lock.json -diff linguist-generated
docs/**/*.md linguist-documentation
