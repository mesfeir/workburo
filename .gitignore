# ---- dependencies & build output (never commit) ----
node_modules/
dist/
release/
*.tsbuildinfo
.vite/

# ---- secrets: this repo is public, nothing here may hold a credential ----
# the app stores config (including the API key) under %APPDATA%\zen-chat\, i.e.
# OUTSIDE the repo. These patterns catch a copy that ever lands here by accident.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets.json
credentials.json
zen-chat-store.json
window-state.json
!zen-chat-store.example.json

# ---- local logs & scratch ----
*.log
npm-debug.log*
.probe/
.cache/

# ---- editors / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# never commit scratch output that lands in the repo folder: the picture probe wrote a
# 13 MB copy of a real conversation (with the screenshots in it) here once, and "git add -A"
# took it. Anything a probe writes belongs in the Hermes scratch dir, not the repo.
/sent-messages.json
/picture-context-probe.cjs
/*-probe.cjs

# ---- ours, not the reader's ----
# The marketing plan and the build worklist stay on disk and out of the repo. They were committed
# once, so they are also removed from history rather than only untracked.
/MARKETING.md
/WORKLIST.md
# electron nightly release metadata, 1.3 MB, left behind by a curl during a research step
/er.json
# the pricing suite caches fal's rate map here on purpose, so it is real state, not source
/zen-chat/
# The deploy script lives beside the site on the Mac and already excludes itself from what it uploads,
# so it has never been served. It still holds a Cloudflare zone id and an account id, neither of which
# belongs in a public repository, and one careless `git add -A` would put them here.
/site/deploy.sh
