{
  "name": "workburo",
  "private": true,
  "version": "1.0.19",
  "description": "WorkBuro, a desktop client for any OpenAI-compatible API (OpenCode Zen / Go, OpenAI, local LLMs)",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Mel",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build": "tsc --noEmit && vite build",
    "electron": "electron .",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win --dir && node scripts/apply-icon.cjs && electron-builder --win nsis portable --prepackaged release/win-unpacked",
    "dist:mac": "npm run build && electron-builder --mac dmg zip",
    "dist:dir": "npm run build && electron-builder --win --dir && node scripts/apply-icon.cjs",
    "selftest": "electron . --selftest",
    "test:images": "node scripts/test-images.cjs",
    "test:titles": "node scripts/test-titles.cjs",
    "test:agent": "node scripts/test-agent.cjs",
    "test:local": "node scripts/test-local.cjs",
    "test:models": "node scripts/test-models.cjs",
    "test:paths": "node scripts/test-paths.cjs",
    "test:outputs": "node scripts/test-outputs.cjs",
    "test:image-tool": "node scripts/test-image-tool.cjs",
    "test:errors": "node scripts/test-errors.cjs",
    "test:mcp": "node scripts/test-mcp.cjs",
    "test:messages": "node scripts/test-messages.cjs",
    "test:pricing": "node scripts/test-pricing.cjs",
    "test:edit": "node scripts/test-edit.cjs",
    "test:tools": "node scripts/test-tools.cjs",
    "test:files": "node scripts/test-files.cjs",
    "test:documents": "node scripts/test-documents.cjs",
    "test:composio": "node scripts/test-composio.cjs",
    "test:create": "node scripts/test-create.cjs",
    "test": "node scripts/check-syntax.cjs && npm run test:titles --silent && npm run test:agent --silent && npm run test:local --silent && npm run test:models --silent && npm run test:paths --silent && npm run test:outputs --silent && npm run test:image-tool --silent && npm run test:tools --silent && npm run test:searxng --silent && npm run test:files --silent && npm run test:documents --silent && npm run test:messages --silent && npm run test:errors --silent && npm run test:create --silent && npm run test:mcp --silent && npm run test:images --silent && npm run test:edit --silent && npm run test:pricing --silent && npm run test:composio --silent && npm run test:web --silent",
    "test:searxng": "node scripts/test-searxng.cjs",
    "check:syntax": "node scripts/check-syntax.cjs",
    "predist": "npm run check:syntax",
    "check:packaged": "node scripts/check-packaged-files.cjs",
    "test:web": "node scripts/test-web.cjs"
  },
  "dependencies": {
    "docx": "^9.8.1",
    "highlight.js": "^11.10.0",
    "lucide-react": "^0.460.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.3.289",
    "pdfkit": "^0.20.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.0.0",
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "typebox": "^1.3.34",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "uk.clearestlab.workburo",
    "productName": "WorkBuro",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "scripts/fixtures/**/*",
      "package.json",
      "node_modules/**/*",
      "!**/node_modules/@napi-rs/**"
    ],
    "asarUnpack": [
      "**/node_modules/pdfjs-dist/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "build/icon-512.png",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "WorkBuro-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WorkBuro",
      "artifactName": "WorkBuro-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "WorkBuro-${version}-portable.${ext}"
    }
  }
}
